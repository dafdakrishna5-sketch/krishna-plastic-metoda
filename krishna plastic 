<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Krishna Plastic | Metoda GIDC Disposable Wholesale & Retail</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Font Awesome for clean icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brandBlue: '#2874f0',
            brandDark: '#172337',
            brandAmber: '#ff9f00',
            brandOrange: '#fb641b',
            brandGreen: '#388e3c',
          }
        }
      }
    };
  </script>

  <style>
    /* Hide scrollbar for horizontal category pills while keeping scrollability */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    /* Smooth slide-in animation for drawers */
    @keyframes slideInRight {
      from { transform: translateX(100%); }
      to { transform: translateX(0); }
    }
    .animate-slide-in {
      animation: slideInRight 0.25s ease-out forwards;
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased selection:bg-blue-100 selection:text-brandBlue">

  <!-- Top Sticky Header (Flipkart/Amazon inspired) -->
  <header class="sticky top-0 z-40 bg-brandBlue text-white shadow-md">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 py-2.5 sm:py-3">
      <!-- Top Row: Brand & Cart -->
      <div class="flex items-center justify-between gap-3">
        <!-- Brand Name & Location Badge -->
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-white text-brandBlue flex items-center justify-center font-extrabold text-xl shadow-sm shrink-0">
            <i class="fa-solid fa-box-open"></i>
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h1 class="text-lg sm:text-xl font-extrabold tracking-tight truncate">Krishna Plastic</h1>
              <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-400 text-slate-900">
                Wholesale & Retail
              </span>
            </div>
            <p class="text-[11px] sm:text-xs text-blue-100 flex items-center gap-1 truncate">
              <i class="fa-solid fa-location-dot text-amber-300"></i>
              <span>Vanijya Bhavan, Gate No. 3, Metoda GIDC, Rajkot</span>
            </p>
          </div>
        </div>

        <!-- Desktop Search Bar -->
        <div class="hidden md:flex flex-1 max-w-xl mx-4">
          <div class="relative w-full">
            <input
              type="text"
              id="desktopSearchInput"
              placeholder="Search LL, HDPE, PP bags, thermocol dish, sugarcane plate, cups..."
              class="w-full pl-4 pr-10 py-2.5 rounded-lg bg-white text-slate-800 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 shadow-inner"
            />
            <button
              type="button"
              id="desktopClearSearch"
              class="hidden absolute right-9 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1"
              title="Clear search"
            >
              <i class="fa-solid fa-xmark"></i>
            </button>
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-brandBlue">
              <i class="fa-solid fa-magnifying-glass"></i>
            </span>
          </div>
        </div>

        <!-- Right Actions: Store Info & Cart Button -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <button
            onclick="openStoreInfoModal()"
            class="hidden sm:flex items-center gap-1.5 px-3 py-2 rounded-lg bg-blue-600/70 hover:bg-blue-600 text-xs font-medium transition border border-blue-400/30"
          >
            <i class="fa-solid fa-store"></i>
            <span>Store Info</span>
          </button>

          <button
            onclick="toggleCartDrawer(true)"
            class="relative flex items-center gap-2 bg-white text-brandBlue hover:bg-blue-50 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl font-bold text-sm shadow-sm transition active:scale-95"
            aria-label="Open Shopping Cart"
          >
            <i class="fa-solid fa-cart-shopping text-base"></i>
            <span class="hidden sm:inline">Cart</span>
            <span
              id="headerCartBadge"
              class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 text-xs font-extrabold rounded-full bg-brandOrange text-white"
            >
              0
            </span>
          </button>
        </div>
      </div>

      <!-- Mobile Search Bar -->
      <div class="mt-2.5 md:hidden">
        <div class="relative w-full">
          <input
            type="text"
            id="mobileSearchInput"
            placeholder="Search LL, HDPE, PP, Thermocol, Sugarcane..."
            class="w-full pl-9 pr-9 py-2 rounded-lg bg-white text-slate-800 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 shadow-inner"
          />
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">
            <i class="fa-solid fa-magnifying-glass"></i>
          </span>
          <button
            type="button"
            id="mobileClearSearch"
            class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1"
          >
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Category Pills Navigation Bar -->
    <div class="bg-white text-slate-700 border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-3 sm:px-6">
        <div id="categoryTabs" class="flex items-center gap-2 py-2.5 overflow-x-auto no-scrollbar">
          <!-- Category buttons injected dynamically by JS -->
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-3 sm:px-6 py-4 sm:py-6 pb-24">
    <!-- Promotional / GIDC Wholesale Banner -->
    <section class="mb-5 bg-gradient-to-r from-brandDark via-slate-800 to-blue-900 rounded-2xl p-4 sm:p-6 text-white shadow-sm relative overflow-hidden">
      <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-400/20 border border-amber-400/40 text-amber-300 text-xs font-semibold mb-2">
            <i class="fa-solid fa-bolt"></i>
            <span>Wholesale & Retail All-in-One Store • Metoda GIDC</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight">
            LL, HDPE, PP Bags & All Disposables at Factory Rates
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-xl">
            Complete stock of LL/HDPE/PP Polythene Bags, Round Thermocol & Sugarcane Bagasse Dishes, Cups & Containers at Vanijya Bhavan, Gate No. 3.
          </p>
        </div>
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <div class="bg-white/10 backdrop-blur-sm border border-white/15 rounded-xl px-3.5 py-2 text-center">
            <div class="text-xs text-slate-300">Open Today</div>
            <div class="text-sm font-bold text-emerald-400">Up to 8:15 PM</div>
          </div>
          <button
            onclick="openStoreInfoModal()"
            class="bg-amber-400 hover:bg-amber-300 text-slate-900 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl shadow transition active:scale-95"
          >
            Location & Timings
          </button>
        </div>
      </div>
      <!-- Decorative background circles -->
      <div class="absolute -right-10 -bottom-10 w-44 h-44 rounded-full bg-brandBlue/20 pointer-events-none"></div>
      <div class="absolute right-24 -top-12 w-32 h-32 rounded-full bg-amber-400/10 pointer-events-none"></div>
    </section>

    <!-- Results Header & Sort -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <div>
        <h3 id="currentCategoryTitle" class="text-base sm:text-lg font-bold text-slate-800">
          All Disposable & Packaging Items
        </h3>
        <p id="itemCountText" class="text-xs text-slate-500">Showing wholesale & retail items</p>
      </div>

      <div class="flex items-center gap-2">
        <label for="sortSelect" class="text-xs text-slate-500 hidden sm:inline">Sort by:</label>
        <select
          id="sortSelect"
          class="bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs sm:text-sm font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-brandBlue"
        >
          <option value="featured">Recommended</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="name-asc">Name: A to Z</option>
        </select>
      </div>
    </div>

    <!-- Product Grid -->
    <div id="productGrid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5">
      <!-- Product Cards rendered dynamically via JS -->
    </div>

    <!-- Empty Search State -->
    <div id="emptyState" class="hidden bg-white rounded-2xl border border-slate-200 p-10 text-center my-6">
      <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3 text-2xl">
        <i class="fa-solid fa-box-open"></i>
      </div>
      <h4 class="text-base font-bold text-slate-800">No disposable items found</h4>
      <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-md mx-auto">
        We couldn't find any item matching your search or filter. Try resetting your search or browse all categories.
      </p>
      <button
        onclick="resetFilters()"
        class="mt-4 px-5 py-2 rounded-xl bg-brandBlue text-white text-sm font-semibold hover:bg-blue-600 transition"
      >
        View All Items
      </button>
    </div>
  </main>

  <!-- Mobile Sticky Bottom Cart Bar (visible when cart has items) -->
  <div
    id="mobileBottomCartBar"
    class="fixed bottom-3 left-3 right-3 z-30 md:hidden hidden transition-all duration-200"
  >
    <button
      onclick="toggleCartDrawer(true)"
      class="w-full bg-brandGreen hover:bg-green-700 text-white rounded-2xl px-4 py-3 shadow-lg flex items-center justify-between font-bold text-sm active:scale-[0.99]"
    >
      <div class="flex items-center gap-2.5">
        <span id="bottomBarCount" class="bg-white/20 px-2.5 py-0.5 rounded-lg text-xs font-extrabold">
          0 Items
        </span>
        <span id="bottomBarTotal" class="text-base font-extrabold">₹0</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span>View Cart & Order</span>
        <i class="fa-solid fa-chevron-right text-xs"></i>
      </div>
    </button>
  </div>

  <!-- Shopping Cart & Checkout Slide-over Drawer -->
  <div id="cartDrawerBackdrop" class="fixed inset-0 z-50 hidden">
    <!-- Backdrop -->
    <div
      onclick="toggleCartDrawer(false)"
      class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity"
    ></div>

    <!-- Drawer Panel -->
    <aside class="fixed top-0 right-0 bottom-0 w-full max-w-md bg-white shadow-2xl flex flex-col animate-slide-in z-10">
      <!-- Drawer Header -->
      <div class="px-4 py-3.5 bg-brandBlue text-white flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2.5">
          <i class="fa-solid fa-bag-shopping text-lg"></i>
          <div>
            <h2 class="font-bold text-base leading-tight">Your Order Cart</h2>
            <p class="text-[11px] text-blue-100">Krishna Plastic • Metoda GIDC</p>
          </div>
        </div>
        <button
          onclick="toggleCartDrawer(false)"
          class="w-8 h-8 rounded-lg bg-white/15 hover:bg-white/25 flex items-center justify-center text-white transition"
          aria-label="Close Cart"
        >
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Drawer Body (Scrollable) -->
      <div class="flex-1 overflow-y-auto p-4 space-y-4">
        <!-- Empty Cart State -->
        <div id="emptyCartMessage" class="py-12 text-center">
          <div class="w-20 h-20 rounded-full bg-blue-50 text-brandBlue flex items-center justify-center mx-auto mb-3 text-3xl">
            <i class="fa-solid fa-cart-plus"></i>
          </div>
          <h3 class="font-bold text-slate-800 text-base">Your cart is empty</h3>
          <p class="text-xs text-slate-500 mt-1 max-w-xs mx-auto">
            Add paper cups, plates, food containers, or carry bags from our Metoda GIDC catalog.
          </p>
          <button
            onclick="toggleCartDrawer(false)"
            class="mt-5 px-5 py-2.5 rounded-xl bg-brandBlue text-white text-sm font-semibold hover:bg-blue-600 transition"
          >
            Browse Catalog
          </button>
        </div>

        <!-- Cart Items List -->
        <div id="cartItemsContainer" class="space-y-3 hidden">
          <!-- Cart item rows injected via JS -->
        </div>

        <!-- Bill Summary & Checkout Form (shown when cart has items) -->
        <div id="checkoutSection" class="hidden space-y-4 pt-2 border-t border-slate-200">
          <!-- Bill Details Card -->
          <div class="bg-slate-50 rounded-xl p-3.5 border border-slate-200 space-y-2 text-sm">
            <div class="flex items-center justify-between">
              <span class="font-bold text-slate-800">Bill Summary</span>
              <label class="inline-flex items-center gap-1.5 text-xs text-slate-600 cursor-pointer select-none">
                <input type="checkbox" id="gstToggle" checked class="rounded text-brandBlue focus:ring-brandBlue" />
                <span>Include 18% GST Invoice</span>
              </label>
            </div>

            <div class="flex justify-between text-slate-600 text-xs sm:text-sm">
              <span>Items Subtotal</span>
              <span id="billSubtotal" class="font-semibold text-slate-800">₹0</span>
            </div>
            <div id="gstRow" class="flex justify-between text-slate-600 text-xs sm:text-sm">
              <span>GST (18%)</span>
              <span id="billGst" class="font-semibold text-slate-800">₹0</span>
            </div>
            <div class="flex justify-between text-slate-600 text-xs sm:text-sm">
              <span>Delivery / Handling</span>
              <span class="font-semibold text-brandGreen">FREE (Metoda GIDC)</span>
            </div>
            <div class="pt-2 border-t border-slate-200 flex justify-between items-center text-base font-extrabold text-slate-900">
              <span>Grand Total</span>
              <span id="billGrandTotal" class="text-brandBlue">₹0</span>
            </div>
          </div>

          <!-- Customer Checkout Form -->
          <form id="checkoutForm" class="space-y-3">
            <h4 class="font-bold text-sm text-slate-800 flex items-center gap-1.5">
              <i class="fa-solid fa-truck-fast text-brandBlue"></i>
              <span>Customer & Delivery Details</span>
            </h4>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Full Name *</label>
              <input
                type="text"
                id="custName"
                required
                placeholder="e.g. Rajesh Patel"
                class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-brandBlue"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Mobile / WhatsApp *</label>
                <input
                  type="tel"
                  id="custPhone"
                  required
                  placeholder="e.g. 98250 XXXXX"
                  class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-brandBlue"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Company / Shop (Optional)</label>
                <input
                  type="text"
                  id="custCompany"
                  placeholder="e.g. Shreeji Industries"
                  class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-brandBlue"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Fulfillment Option</label>
              <div class="grid grid-cols-2 gap-2">
                <label class="flex items-center gap-2 p-2.5 rounded-lg border border-slate-200 bg-white cursor-pointer hover:border-brandBlue text-xs font-medium">
                  <input type="radio" name="deliveryMode" value="Metoda GIDC Local Delivery" checked class="text-brandBlue" />
                  <span>GIDC Local Delivery</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-lg border border-slate-200 bg-white cursor-pointer hover:border-brandBlue text-xs font-medium">
                  <input type="radio" name="deliveryMode" value="Gate No. 3 Shop Pickup" class="text-brandBlue" />
                  <span>Gate No. 3 Pickup</span>
                </label>
              </div>
            </div>

            <div id="addressFieldGroup">
              <label class="block text-xs font-semibold text-slate-700 mb-1">Plot No. / Delivery Address *</label>
              <textarea
                id="custAddress"
                rows="2"
                required
                placeholder="Plot No., Road / Gate No., Metoda GIDC..."
                class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-brandBlue"
              ></textarea>
            </div>
          </form>
        </div>
      </div>

      <!-- Drawer Footer -->
      <div id="cartDrawerFooter" class="hidden p-4 bg-white border-t border-slate-200 shrink-0">
        <button
          type="submit"
          form="checkoutForm"
          class="w-full py-3 px-4 rounded-xl bg-brandOrange hover:bg-orange-600 text-white font-extrabold text-sm sm:text-base shadow-md flex items-center justify-center gap-2 transition active:scale-[0.99]"
        >
          <span>Place Order / Generate Bill</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </aside>
  </div>

  <!-- Order Receipt Modal -->
  <div id="receiptModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-3 sm:p-4">
    <div onclick="closeReceiptModal()" class="fixed inset-0 bg-slate-900/70 backdrop-blur-xs"></div>
    <div class="relative bg-white rounded-2xl max-w-md w-full shadow-2xl overflow-hidden z-10 max-h-[90vh] flex flex-col">
      <!-- Top Success Banner -->
      <div class="bg-brandGreen text-white p-5 text-center shrink-0">
        <div class="w-12 h-12 rounded-full bg-white text-brandGreen flex items-center justify-center mx-auto mb-2 text-2xl shadow">
          <i class="fa-solid fa-check"></i>
        </div>
        <h3 class="text-lg font-extrabold">Order Confirmed!</h3>
        <p class="text-xs text-green-100 mt-0.5">Krishna Plastic • Vanijya Bhavan, Gate No. 3</p>
      </div>

      <!-- Receipt Content -->
      <div id="receiptContent" class="p-4 sm:p-5 overflow-y-auto space-y-3 text-sm">
        <!-- Populated dynamically via JS -->
      </div>

      <!-- Receipt Actions -->
      <div class="p-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row gap-2 shrink-0">
        <button
          onclick="copyReceiptText()"
          class="flex-1 py-2.5 px-3 rounded-xl bg-brandBlue hover:bg-blue-600 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 transition"
        >
          <i class="fa-regular fa-copy"></i>
          <span>Copy Order Details</span>
        </button>
        <button
          onclick="shareToWhatsApp()"
          class="flex-1 py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 transition"
        >
          <i class="fa-brands fa-whatsapp text-base"></i>
          <span>Send on WhatsApp</span>
        </button>
        <button
          onclick="closeReceiptModal()"
          class="py-2.5 px-4 rounded-xl border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 font-semibold text-xs sm:text-sm"
        >
          Done
        </button>
      </div>
    </div>
  </div>

  <!-- Store Info Modal -->
  <div id="storeInfoModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
    <div onclick="closeStoreInfoModal()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs"></div>
    <div class="relative bg-white rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-2xl z-10">
      <div class="flex items-start justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-blue-50 text-brandBlue flex items-center justify-center text-xl font-bold">
            <i class="fa-solid fa-store"></i>
          </div>
          <div>
            <h3 class="font-extrabold text-lg text-slate-900">Krishna Plastic</h3>
            <p class="text-xs text-slate-500">Wholesale & Retail Disposable Suppliers</p>
          </div>
        </div>
        <button onclick="closeStoreInfoModal()" class="text-slate-400 hover:text-slate-600 p-1">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <div class="space-y-3 text-sm text-slate-700">
        <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50">
          <i class="fa-solid fa-location-dot text-brandBlue mt-1"></i>
          <div>
            <div class="font-semibold text-slate-900">Store Address</div>
            <p class="text-xs text-slate-600 mt-0.5">
              Inside Vanijya Bhavan, Gate No. 3, Metoda GIDC, Lodhika, Rajkot, Gujarat 360021
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50">
          <i class="fa-regular fa-clock text-brandGreen mt-1"></i>
          <div>
            <div class="font-semibold text-slate-900">Business Hours</div>
            <p class="text-xs text-slate-600 mt-0.5">
              Monday – Sunday: 9:00 AM to 8:15 PM
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50">
          <i class="fa-solid fa-truck text-amber-600 mt-1"></i>
          <div>
            <div class="font-semibold text-slate-900">Bulk & Industrial Supply</div>
            <p class="text-xs text-slate-600 mt-0.5">
              Special carton rates available for Metoda GIDC factories, canteens, caterers, and events.
            </p>
          </div>
        </div>
      </div>

      <button
        onclick="closeStoreInfoModal()"
        class="mt-5 w-full py-2.5 rounded-xl bg-brandBlue text-white font-bold text-sm hover:bg-blue-600 transition"
      >
        Start Shopping
      </button>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed bottom-16 md:bottom-6 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Application Logic -->
