    // Load saved cart from localStorage if available
    try {
      const savedCart = localStorage.getItem('krishna_plastic_cart');
      if (savedCart) {
        state.cart = JSON.parse(savedCart);
      }
    } catch (e) {
      console.warn('Could not read saved cart:', e);
    }

    function saveCart() {
      try {
        localStorage.setItem('krishna_plastic_cart', JSON.stringify(state.cart));
      } catch (e) {
        // Ignore storage errors
      }
    }

    // Format currency in INR
    function formatINR(amount) {
      return '₹' + Math.round(amount).toLocaleString('en-IN');
    }

    // Show toast notification
    function showToast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      const bgClass = type === 'success' ? 'bg-slate-900 text-white' : 'bg-red-600 text-white';
      toast.className = `${bgClass} px-4 py-2.5 rounded-xl shadow-lg text-xs sm:text-sm font-medium flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0`;
      toast.innerHTML = `
        <i class="fa-solid ${type === 'success' ? 'fa-circle-check text-emerald-400' : 'fa-circle-exclamation'}"></i>
        <span>${message}</span>
      `;
      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 2200);
    }

    // Render Category Pills
    function renderCategories() {
      const container = document.getElementById('categoryTabs');
      container.innerHTML = CATEGORIES.map(cat => {
        const isActive = state.selectedCategory === cat;
        return `
          <button
            onclick="selectCategory('${cat.replace(/'/g, "\\'")}')"
            class="px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition ${
              isActive
                ? 'bg-brandBlue text-white shadow-xs'
                : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
            }"
          >
            ${cat}
          </button>
        `;
      }).join('');
    }

    function selectCategory(category) {
      state.selectedCategory = category;
      document.getElementById('currentCategoryTitle').textContent =
        category === 'All Items' ? 'All Disposable & Packaging Items' : category;
      renderCategories();
      renderProducts();
    }

    function resetFilters() {
      state.selectedCategory = 'All Items';
      state.searchQuery = '';
      state.sortBy = 'featured';
      document.getElementById('desktopSearchInput').value = '';
      document.getElementById('mobileSearchInput').value = '';
      document.getElementById('desktopClearSearch').classList.add('hidden');
      document.getElementById('mobileClearSearch').classList.add('hidden');
      document.getElementById('sortSelect').value = 'featured';
      selectCategory('All Items');
    }

    // Filter and sort products
    function getFilteredProducts() {
      let filtered = PRODUCTS.filter(item => {
        const matchesCat =
          state.selectedCategory === 'All Items' || item.category === state.selectedCategory;
        const q = state.searchQuery.trim().toLowerCase();
        const matchesQuery =
          !q ||
          item.name.toLowerCase().includes(q) ||
          item.category.toLowerCase().includes(q) ||
          item.spec.toLowerCase().includes(q) ||
          (item.materialTag && item.materialTag.toLowerCase().includes(q));
        return matchesCat && matchesQuery;
      });

      if (state.sortBy === 'price-asc') {
        filtered.sort((a, b) => a.price - b.price);
      } else if (state.sortBy === 'price-desc') {
        filtered.sort((a, b) => b.price - a.price);
      } else if (state.sortBy === 'name-asc') {
        filtered.sort((a, b) => a.name.localeCompare(b.name));
      }

      return filtered;
    }

    // Render Product Grid
