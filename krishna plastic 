      const grid = document.getElementById('productGrid');
      const emptyState = document.getElementById('emptyState');
      const countText = document.getElementById('itemCountText');
      const items = getFilteredProducts();

      countText.textContent = `Showing ${items.length} wholesale ${items.length === 1 ? 'item' : 'items'}`;

      if (items.length === 0) {
        grid.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      grid.innerHTML = items.map(product => {
        const qty = state.cart[product.id] || 0;
        const discountPct = Math.round(((product.mrp - product.price) / product.mrp) * 100);
        const unit = product.unitLabel || 'Pack';

        return `
          <div class="bg-white rounded-2xl border border-slate-200/90 hover:border-brandBlue/50 hover:shadow-md transition flex flex-col justify-between overflow-hidden group">
            <div>
              <!-- Visual Header / Icon Illustration -->
              <div class="relative ${product.accentBg} border-b ${product.borderAccent} p-4 sm:p-5 flex items-center justify-center h-32 sm:h-36">
                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-slate-900/85 text-white shadow-2xs tracking-wide">
                  ${product.materialTag || product.badge}
                </span>
                <span class="absolute top-2.5 right-2.5 px-1.5 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-600 text-white">
                  ${discountPct}% OFF
                </span>

                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white shadow-xs flex items-center justify-center ${product.accentText} text-3xl sm:text-4xl group-hover:scale-105 transition-transform">
                  <i class="fa-solid ${product.icon}"></i>
                </div>
              </div>

              <!-- Product Details -->
              <div class="p-3 sm:p-4 pb-2">
                <div class="flex items-center justify-between gap-1">
                  <span class="text-[10px] sm:text-[11px] font-semibold text-brandBlue uppercase tracking-wide truncate">
                    ${product.category}
                  </span>
                </div>
                <h4 class="font-bold text-slate-900 text-xs sm:text-sm mt-0.5 line-clamp-2 min-h-[2.25rem] sm:min-h-[2.5rem]">
                  ${product.name}
                </h4>
                <p class="text-[11px] sm:text-xs text-slate-500 mt-1 flex items-center gap-1">
                  <i class="fa-solid fa-layer-group text-[10px] text-slate-400"></i>
                  <span class="truncate">${product.spec}</span>
                </p>
              </div>
            </div>

            <!-- Price & Add to Cart Action -->
            <div class="p-3 sm:p-4 pt-1">
              <div class="flex items-baseline gap-1.5 mb-2.5">
                <span class="text-base sm:text-lg font-extrabold text-slate-900">${formatINR(product.price)}</span>
                <span class="text-[11px] text-slate-400 line-through">${formatINR(product.mrp)}</span>
                <span class="ml-auto text-[10px] font-semibold text-brandGreen bg-green-50 px-1.5 py-0.5 rounded">
                  /${unit}
                </span>
              </div>

              ${
                qty === 0
                  ? `
                    <button
                      onclick="updateCartQty('${product.id}', 1)"
                      class="w-full py-2 px-3 rounded-xl bg-blue-50 hover:bg-brandBlue text-brandBlue hover:text-white border border-brandBlue/30 font-bold text-xs sm:text-sm transition flex items-center justify-center gap-1.5 active:scale-95"
                    >
                      <i class="fa-solid fa-plus text-xs"></i>
                      <span>Add</span>
                    </button>
                  `
                  : `
                    <div class="w-full flex items-center justify-between bg-brandBlue text-white rounded-xl overflow-hidden shadow-xs">
                      <button
                        onclick="updateCartQty('${product.id}', -1)"
                        class="w-10 h-9 flex items-center justify-center hover:bg-blue-700 transition font-bold"
                        aria-label="Decrease quantity"
                      >
                        <i class="fa-solid fa-minus text-xs"></i>
                      </button>
                      <span class="font-extrabold text-xs sm:text-sm">${qty} ${unit}${qty > 1 ? 's' : ''}</span>
                      <button
                        onclick="updateCartQty('${product.id}', 1)"
                        class="w-10 h-9 flex items-center justify-center hover:bg-blue-700 transition font-bold"
                        aria-label="Increase quantity"
                      >
                        <i class="fa-solid fa-plus text-xs"></i>
                      </button>
                    </div>
                  `
              }
            </div>
          </div>
        `;
      }).join('');
    }

    // Update Cart Quantity
    function updateCartQty(productId, delta) {
      const current = state.cart[productId] || 0;
      const next = current + delta;
      const product = PRODUCTS.find(p => p.id === productId);

      if (next <= 0) {
        delete state.cart[productId];
        if (product) showToast(`Removed ${product.name} from cart`);
      } else {
        state.cart[productId] = next;
        if (current === 0 && product) {
          showToast(`Added ${product.name} to cart`);
        }
      }

      saveCart();
      renderProducts();
      updateCartUI();
    }

    function removeFromCart(productId) {
      delete state.cart[productId];
      saveCart();
      renderProducts();
      updateCartUI();
    }

    // Calculate Cart Totals
    function getCartSummary() {
      let totalPacks = 0;
      let subtotal = 0;
      const lines = [];

      Object.entries(state.cart).forEach(([id, qty]) => {
        const product = PRODUCTS.find(p => p.id === id);
        if (product && qty > 0) {
          const lineTotal = product.price * qty;
          totalPacks += qty;
          subtotal += lineTotal;
          lines.push({ product, qty, lineTotal });
        }
      });

      const gstAmount = state.includeGst ? subtotal * 0.18 : 0;
      const grandTotal = subtotal + gstAmount;

      return { totalPacks, subtotal, gstAmount, grandTotal, lines };
    }

    // Update Cart Drawer, Header Badge & Bottom Bar
    function updateCartUI() {
      const { totalPacks, subtotal, gstAmount, grandTotal, lines } = getCartSummary();

      // Update Header Badge
      document.getElementById('headerCartBadge').textContent = totalPacks;

      // Update Mobile Bottom Cart Bar
      const bottomBar = document.getElementById('mobileBottomCartBar');
      if (totalPacks > 0) {
        bottomBar.classList.remove('hidden');
        document.getElementById('bottomBarCount').textContent = `${totalPacks} Item${totalPacks > 1 ? 's' : ''}`;
        document.getElementById('bottomBarTotal').textContent = formatINR(grandTotal);
      } else {
        bottomBar.classList.add('hidden');
      }

      // Update Cart Drawer Content
      const emptyMsg = document.getElementById('emptyCartMessage');
      const itemsContainer = document.getElementById('cartItemsContainer');
      const checkoutSection = document.getElementById('checkoutSection');
      const drawerFooter = document.getElementById('cartDrawerFooter');

      if (lines.length === 0) {
        emptyMsg.classList.remove('hidden');
        itemsContainer.classList.add('hidden');
        checkoutSection.classList.add('hidden');
        drawerFooter.classList.add('hidden');
        return;
      }
      itemsContainer.innerHTML = lines.map(({ product, qty, lineTotal }) => {
        const unit = (product.unitLabel || 'Pack').toLowerCase();
        return `
        <div class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 bg-white">
          <div class="w-12 h-12 rounded-xl ${product.accentBg} ${product.accentText} flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid ${product.icon}"></i>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-slate-100 text-slate-700">${product.materialTag || ''}</span>
              <h5 class="font-bold text-xs sm:text-sm text-slate-900 truncate">${product.name}</h5>
            </div>
            <p class="text-[11px] text-slate-500">${product.spec} • ${formatINR(product.price)}/${unit}</p>
            <div class="mt-1.5 flex items-center justify-between">
              <div class="inline-flex items-center border border-slate-300 rounded-lg overflow-hidden">
                <button
                  onclick="updateCartQty('${product.id}', -1)"
                  class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs"
                >-</button>
                <span class="px-2.5 py-0.5 text-xs font-extrabold text-slate-900">${qty}</span>
                <button
                  onclick="updateCartQty('${product.id}', 1)"
                  class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs"
                >+</button>
              </div>
              <span class="font-extrabold text-sm text-slate-900">${formatINR(lineTotal)}</span>
            </div>
          </div>
          <button
            onclick="removeFromCart('${product.id}')"
            class="text-slate-400 hover:text-red-500 p-1.5 transition"
            title="Remove item"
          >
            <i class="fa-solid fa-trash-can text-xs"></i>
          </button>
        </div>
      `;
      }).join('');

      // Update Bill Summary numbers
      document.getElementById('billSubtotal').textContent = formatINR(subtotal);
      document.getElementById('billGst').textContent = formatINR(gstAmount);
      document.getElementById('billGrandTotal').textContent = formatINR(grandTotal);
      document.getElementById('gstRow').style.display = state.includeGst ? 'flex' : 'none';
    }

    // Drawer & Modal Controls
    function toggleCartDrawer(open) {
      const backdrop = document.getElementById('cartDrawerBackdrop');
      if (open) {
        updateCartUI();
        backdrop.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } else {
        backdrop.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    function openStoreInfoModal() {
      document.getElementById('storeInfoModal').classList.remove('hidden');
    }

    function closeStoreInfoModal() {
      document.getElementById('storeInfoModal').classList.add('hidden');
    }

    function closeReceiptModal() {
      document.getElementById('receiptModal').classList.add('hidden');
    }

    // Handle Order Submission & Receipt Generation
    function handlePlaceOrder(e) {
      e.preventDefault();
      const { totalPacks, subtotal, gstAmount, grandTotal, lines } = getCartSummary();
      if (lines.length === 0) return;

      const custName = document.getElementById('custName').value.trim();
      const custPhone = document.getElementById('custPhone').value.trim();
      const custCompany = document.getElementById('custCompany').value.trim();
      const deliveryMode = document.querySelector('input[name="deliveryMode"]:checked').value;
      const custAddress = document.getElementById('custAddress').value.trim();

      const orderId = 'KP-' + Math.floor(100000 + Math.random() * 900000);
      const orderDate = new Date().toLocaleString('en-IN', {
        dateStyle: 'medium',
        timeStyle: 'short'
      });

      // Build plain text receipt for Copy / WhatsApp sharing
      const itemLinesText = lines
        .map((l, idx) => `${idx + 1}. ${l.product.name} (${l.product.spec}) x ${l.qty} = ${formatINR(l.lineTotal)}`)
        .join('\n');

      state.lastReceiptText = [
        `*NEW ORDER - KRISHNA PLASTIC*`,
        `📍 Vanijya Bhavan, Gate No. 3, Metoda GIDC`,
        `🆔 Order ID: ${orderId}`,
        `📅 Date: ${orderDate}`,
        `--------------------------`,
        `👤 Customer: ${custName}${custCompany ? ' (' + custCompany + ')' : ''}`,
        `📞 Phone: ${custPhone}`,
        `🚚 Mode: ${deliveryMode}`,
        custAddress ? `🏠 Address: ${custAddress}` : '',
        `--------------------------`,
        `*ITEMS ORDERED (${totalPacks} Packs):*`,
        itemLinesText,
        `--------------------------`,
        `Subtotal: ${formatINR(subtotal)}`,
        state.includeGst ? `GST (18%): ${formatINR(gstAmount)}` : `GST: Not Applied`,
        `*Grand Total: ${formatINR(grandTotal)}*`
      ].filter(Boolean).join('\n');

      // Populate Receipt Modal HTML
      document.getElementById('receiptContent').innerHTML = `
        <div class="flex items-center justify-between bg-slate-50 p-3 rounded-xl border border-slate-200">
          <div>
            <div class="text-[11px] text-slate-500">Order Reference</div>
            <div class="font-extrabold text-slate-900">${orderId}</div>
          </div>
          <div class="text-right">
            <div class="text-[11px] text-slate-500">Order Time</div>
            <div class="font-semibold text-xs text-slate-700">${orderDate}</div>
          </div>
        </div>

        <div class="space-y-1 text-xs bg-blue-50/60 p-3 rounded-xl border border-blue-100">
          <div><span class="font-semibold text-slate-700">Customer:</span> ${custName} ${custCompany ? `(${custCompany})` : ''}</div>
          <div><span class="font-semibold text-slate-700">Phone:</span> ${custPhone}</div>
          <div><span class="font-semibold text-slate-700">Fulfillment:</span> ${deliveryMode}</div>
          ${custAddress ? `<div><span class="font-semibold text-slate-700">Address:</span> ${custAddress}</div>` : ''}
        </div>

        <div>
          <div class="font-bold text-xs text-slate-700 uppercase tracking-wider mb-2">Order Items (${totalPacks} Packs)</div>
          <div class="divide-y divide-slate-100 border border-slate-200 rounded-xl overflow-hidden">
            ${lines.map(l => `
              <div class="p-2.5 flex items-center justify-between text-xs bg-white">
                <div class="pr-2">
                  <div class="font-semibold text-slate-800">${l.product.name}</div>
                  <div class="text-slate-500">${l.product.spec} × ${l.qty}</div>
                </div>
                <div class="font-bold text-slate-900 shrink-0">${formatINR(l.lineTotal)}</div>
              </div>
            `).join('')}
          </div>
        </div>

        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-1 text-xs">
          <div class="flex justify-between text-slate-600">
            <span>Subtotal</span>
            <span>${formatINR(subtotal)}</span>
          </div>
          ${state.includeGst ? `
            <div class="flex justify-between text-slate-600">
              <span>GST (18%)</span>
              <span>${formatINR(gstAmount)}</span>
            </div>
          ` : ''}
          <div class="flex justify-between font-extrabold text-sm text-slate-900 pt-1.5 border-t border-slate-200">
            <span>Total Payable</span>
            <span class="text-brandBlue">${formatINR(grandTotal)}</span>
          </div>
        </div>
      `;

      // Clear cart after placing order
      state.cart = {};
      saveCart();
      renderProducts();
      updateCartUI();
      toggleCartDrawer(false);

      // Show Receipt Modal
      document.getElementById('receiptModal').classList.remove('hidden');
    }

    // Copy Receipt using document.execCommand('copy') for reliable iframe support
    function copyReceiptText() {
      const textarea = document.createElement('textarea');
      textarea.value = state.lastReceiptText;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
        showToast('Order summary copied to clipboard!');
      } catch (err) {
        showToast('Unable to copy text', 'error');
      }
      document.body.removeChild(textarea);
    }

    function shareToWhatsApp() {
      const encoded = encodeURIComponent(state.lastReceiptText);
      window.open(`https://wa.me/?text=${encoded}`, '_blank');
    }

    // Initialize Event Listeners
    document.addEventListener('DOMContentLoaded', () => {
      renderCategories();
      renderProducts();
      updateCartUI();

      // Sync desktop & mobile search inputs
      const desktopSearch = document.getElementById('desktopSearchInput');
      const mobileSearch = document.getElementById('mobileSearchInput');
      const desktopClear = document.getElementById('desktopClearSearch');
      const mobileClear = document.getElementById('mobileClearSearch');

      function handleSearchInput(val) {
        state.searchQuery = val;
        desktopSearch.value = val;
        mobileSearch.value = val;
        desktopClear.classList.toggle('hidden', !val);
        mobileClear.classList.toggle('hidden', !val);
        renderProducts();
      }

      desktopSearch.addEventListener('input', e => handleSearchInput(e.target.value));
      mobileSearch.addEventListener('input', e => handleSearchInput(e.target.value));
      desktopClear.addEventListener('click', () => handleSearchInput(''));
      mobileClear.addEventListener('click', () => handleSearchInput(''));

      // Sort dropdown
      document.getElementById('sortSelect').addEventListener('change', e => {
        state.sortBy = e.target.value;
        renderProducts();
      });

      // GST toggle
      document.getElementById('gstToggle').addEventListener('change', e => {
        state.includeGst = e.target.checked;
        updateCartUI();
      });

      // Fulfillment radio buttons toggle address requirement
      document.querySelectorAll('input[name="deliveryMode"]').forEach(radio => {
        radio.addEventListener('change', e => {
          const isPickup = e.target.value.includes('Pickup');
          const addrInput = document.getElementById('custAddress');
          const addrGroup = document.getElementById('addressFieldGroup');
          if (isPickup) {
            addrInput.removeAttribute('required');
            addrGroup.classList.add('opacity-50');
          } else {
            addrInput.setAttribute('required', 'required');
            addrGroup.classList.remove('opacity-50');
          }
        });
      });

      // Checkout form submit
      document.getElementById('checkoutForm').addEventListener('submit', handlePlaceOrder);
    });
  </script>
</body>
</html>
